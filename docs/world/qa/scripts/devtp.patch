+          return;
+        }
+        if (m && m.t === "devhp") {
+          const o = (gameState as any).world.byEid.get(m.eid);
+          if (o) o.hp = m.hp;
+          return;
+        }
+      } catch {}
+    }
     const data = parseClientMessage(raw.toString());
     if (!data) return; // invalid frame: drop quietly
 
