   let playerId: string | null = null;
 
   ws.on("message", (raw) => {
+    // QA-ONLY (Q1, uncommitted): teleport own ship when PTW_DEV_TELEPORT=1.
+    if (process.env.PTW_DEV_TELEPORT === "1" && playerId) {
+      try {
+        const m = JSON.parse(raw.toString());
